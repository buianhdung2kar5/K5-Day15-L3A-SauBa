# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# --- Chatbot hỏi đáp trong prototype (codebase/retrieval.py) — tất cả tuỳ chọn, bỏ trống dùng mặc định ---
# RAG_MODE: hybrid = BM25 + embedding (mặc định) · bm25 = không gọi API embedding · dense = chỉ embedding
# RAG_CHUNK_WORDS: gom câu đến khoảng bấy nhiêu từ thì cắt chunk · RAG_CHUNK_MAX: chunk không vượt quá số từ này
# RAG_OVERLAP_WORDS: số từ cuối chunk trước lặp lại ở đầu chunk sau · RAG_TOP_K: số đoạn đưa cho model
# RAG_MIN_COSINE: dưới ngưỡng này embedding coi đoạn là không liên quan
# EMBED_MODEL=text-embedding-3-small
# RAG_MODE=hybrid
# RAG_CHUNK_WORDS=180
# RAG_CHUNK_MAX=260
# RAG_OVERLAP_WORDS=40
# RAG_TOP_K=6
# RAG_MIN_COSINE=0.30
